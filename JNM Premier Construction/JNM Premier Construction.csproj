<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Blazor.Cards" Version="35.2.12" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="35.2.12" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\videos\" />
  </ItemGroup>

</Project>
